{
  "name": "rust-game",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Rust-like open-world survival game (Three.js) — web, Android and Windows desktop",
  "author": "MOT1209",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:build": "npx cap build android",
    "cap:open": "npx cap open android",
    "electron:start": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.rashid.rustgame",
    "productName": "Rust Survival 3D",
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
